NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=
# BYOK envelope encryption (server-only). BYOK_ACTIVE_KEK_VERSION selects the
# wrapping key; each BYOK_KEK_<VERSION> is a base64-encoded 32-byte AES key.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BYOK_ACTIVE_KEK_VERSION=v1
BYOK_KEK_v1=
CP2_TEST_USER_A_EMAIL=
CP2_TEST_USER_A_PASSWORD=
CP2_TEST_USER_B_EMAIL=
CP2_TEST_USER_B_PASSWORD=
